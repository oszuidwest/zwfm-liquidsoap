# Copy to .env and set [REQUIRED] values. [OPTIONAL] values may stay commented.
# See README.md for installation, usage and troubleshooting.

# STATION IDENTITY

# [REQUIRED] Station identifier for mount points (lowercase, no spaces)
STATION_ID=myradio

# [REQUIRED] Public station name
STATION_NAME=My Radio Station

# ICECAST STREAMING

# [REQUIRED] Icecast server connection details
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=hackme

# [OPTIONAL] Mount points default to ICECAST_MOUNT_BASE, which defaults to STATION_ID
# ICECAST_MOUNT_BASE=myradio              # Default: {STATION_ID}
# ICECAST_MOUNT_MP3=/myradio.mp3         # Default: /{ICECAST_MOUNT_BASE}.mp3
# ICECAST_MOUNT_AAC_LOW=/myradio.aac     # Default: /{ICECAST_MOUNT_BASE}.aac
# ICECAST_MOUNT_AAC_HIGH=/myradio.stl    # Default: /{ICECAST_MOUNT_BASE}.stl

# [OPTIONAL] Stream bitrates in kbps
# ICECAST_BITRATE_MP3=192
# ICECAST_BITRATE_AAC_LOW=96
# ICECAST_BITRATE_AAC_HIGH=576

# SRT STUDIO INPUTS

# [REQUIRED] Strong encryption passphrase for both studios
SRT_PASSPHRASE=change-this-to-a-secure-passphrase

# [OPTIONAL] SRT bind address and listening ports (ports must be open in firewall)
# SRT_BIND=0.0.0.0                # Default: all host interfaces
# SRT_PORT_PRIMARY=8888          # Studio A
# SRT_PORT_SECONDARY=9999        # Studio B

# AUDIO FALLBACK & SILENCE DETECTION

# [OPTIONAL] Emergency audio file when all inputs fail
# The file must exist and be decodable or Liquidsoap refuses to start
# EMERGENCY_AUDIO_PATH=/audio/fallback.ogg

# [OPTIONAL] Permit silence if the fallback file is unusable (development/testing only)
# EMERGENCY_ALLOW_BLANK=false

# [OPTIONAL] Automatic source switching on silence
# SILENCE_SWITCH_SECONDS=15.0    # Silence duration before failover (seconds)
# AUDIO_VALID_SECONDS=15.0       # Audio duration before recovery (seconds)
# SILENCE_THRESHOLD=-40.0        # Silence threshold (dB)

# SERVER SOCKET (RUNTIME CONTROL)
# Connect from host: socat - UNIX-CONNECT:/opt/liquidsoap/socket/liquidsoap.sock
# Compose exposes the container socket through ./socket on the host.

# [OPTIONAL] Runtime control socket
# SERVER_SOCKET_ENABLED=true
# SERVER_SOCKET_PATH=/tmp/liquidsoap/liquidsoap.sock  # Container path

# STEREOTOOL AUDIO PROCESSING
# Requires license from https://www.stereotool.com/

# [OPTIONAL] License key - leave commented to disable StereoTool
# STEREOTOOL_LICENSE=

# [OPTIONAL] Web interface for StereoTool configuration
# STEREOTOOL_WEB_BIND=0.0.0.0    # Default: all host interfaces
# STEREOTOOL_WEB_PORT=8080

# DAB+ DIGITAL RADIO

# [OPTIONAL] DAB+ encoder settings - both required to enable DAB+
# DAB_BITRATE=128
# DAB_EDI_DESTINATIONS=tcp://dab-mux.example.com:9001

# [OPTIONAL] Multiple EDI destinations (comma-separated)
# DAB_EDI_DESTINATIONS=tcp://primary.example.com:9001,tcp://backup.example.com:9002

# [OPTIONAL] TCP acknowledgement monitoring (default: true; false disables it)
# DAB_ACK_MONITOR_ENABLED=false
# DAB_ACK_POLL_SECONDS=1.0
# DAB_ACK_WARN_SECONDS=5
# DAB_ACK_DOWN_SECONDS=15
# DAB_ACK_STARTUP_GRACE_SECONDS=10

# [OPTIONAL] Programme Associated Data (PAD) for metadata
# Larger PAD sizes send artwork faster but leave less capacity for audio.
# DAB_METADATA_SIZE=8           # Default: 8 when socket is set
# DAB_METADATA_SOCKET=/tmp/pad.sock

# HLS OUTPUT
# HTTP Live Streaming via Bunny Edge Storage + Bunny CDN

# [OPTIONAL] Bunny Edge Storage credentials - both required to enable HLS
# HLS_BUNNY_STORAGE_ZONE=zwfm-hls
# HLS_BUNNY_ACCESS_KEY=storage-zone-read-write-password

# [OPTIONAL] Bunny Edge Storage endpoint
# Use the endpoint shown by Bunny for the storage zone region
# HLS_BUNNY_ENDPOINT=storage.bunnycdn.com

# [OPTIONAL] Local HLS window and bitrate ladder
# HLS_DIR=/hls
# HLS_BITRATE_LOW=48
# HLS_BITRATE_MID=96
# HLS_BITRATE_HIGH=192
# HLS_SEGMENT_DURATION=4.0
# HLS_SEGMENTS=10
# Default: HLS_SEGMENTS + 3 for RFC 8216 cleanup timing
# HLS_SEGMENTS_OVERHEAD=13

# HTTP API (STATUS AND STREAM METADATA)
# [OPTIONAL] Each token enables its endpoint; use distinct values.
# STATUS_BEARER_TOKEN: GET /status; STREAM_METADATA_BEARER_TOKEN: POST /metadata.
# HTTP_BIND=127.0.0.1
# HTTP_PORT=7000
# STREAM_METADATA_BEARER_TOKEN=replace-with-a-long-random-token
# STATUS_BEARER_TOKEN=replace-with-another-long-random-token

# DUTCH MEDIA EXCHANGE (DME)
# Radio Rucphen and BredaNu require all DME settings.

# [OPTIONAL] Primary DME ingestion point - all required for DME
# DME_PRIMARY_HOST=ingest1.dme.nl
# DME_PRIMARY_PORT=8000
# DME_PRIMARY_USER=station-live
# DME_PRIMARY_PASSWORD=secret

# [OPTIONAL] Secondary DME ingestion point - all required for DME
# DME_SECONDARY_HOST=ingest2.dme.nl
# DME_SECONDARY_PORT=8000
# DME_SECONDARY_USER=station-backup
# DME_SECONDARY_PASSWORD=secret

# [OPTIONAL] DME stream mount point - required for DME
# DME_MOUNT_POINT=/live

# DOCKER CONFIGURATION

# [OPTIONAL] Timezone for logs and scheduling
# CONTAINER_TIMEZONE=Europe/Amsterdam
